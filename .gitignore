# Workspace root of the shared MSPProcess devcontainer. Only .devcontainer/
# (and this file) belong to this repo - the product checkouts below are their
# own repos, cloned in beside it.

# The two checkouts this devcontainer serves. Folder names are configurable via
# BACKEND_DIR_NAME / FRONTEND_DIR_NAME in .devcontainer/devcontainer.json; if
# you rename a checkout, rename it here too.
/MSPProcess/
/mspprocess-ui/

# Dev secrets. Created and seeded IN the container by link-local-settings.sh on
# every start, and sourced by local-stack.sh into the backend hosts it launches.
# Nothing on the host creates or reads it (that used to be host-bootstrap.sh, for
# runArgs --env-file - both are gone; the host write is refused on Windows).
.env

# Devcontainer runtime state: sidecar data dirs bind-mounted by compose.yaml,
# the shared pnpm/yarn caches, local-stack pids/logs/selection, and the
# host ~/.claude mount target.
.adlc-artifacts/

.claude
