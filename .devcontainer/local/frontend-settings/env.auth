# .devcontainer/frontend/env.auth
# Local-stack overrides for AlertManager.Auth.Web (mspprocess-ui/Web/AlertManager.Auth.Web),
# sourced by .devcontainer/local-stack-frontend.sh before it
# launches this app's vite dev server.
# Derived from that repo's Web/AlertManager.Auth.Web/config/.env.Development.
# Note: this app's vite.config.ts uses envPrefix 'VITE_', not 'REACT_APP_'.
VITE_BASE_API_URL='http://localhost:5000'
REACT_APP_BASE_MAILBOX_DOMAIN='in.alertmanager.co'
REACT_APP_PROJECT_NAME='MSP Process [local]'
