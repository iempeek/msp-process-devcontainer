# .devcontainer/frontend/env.livechat-widget
# Local-stack overrides for AlertManager.LiveChatWidget (mspprocess-ui/Web/AlertManager.LiveChatWidget),
# sourced by .devcontainer/local-stack-frontend.sh before it
# launches this app's vite dev server.
# Derived from that repo's Web/AlertManager.LiveChatWidget/config/.env.Development.
# REACT_APP_URL points at AlertManager.LiveChat.Api (port 5033 locally, see
# local-stack.sh --run) - NOT the main AlertManager.Api on 5000.
REACT_APP_URL='http://localhost:5033/'
# This app's vite.config.js has its own devServerPlugin that reads PORT from
# the environment and re-applies it in a plugin `config()` hook, which wins
# over local-stack-frontend.sh's `vite --port 3004` CLI flag - without this, it
# falls back to its own hardcoded default (3001) and collides with
# AlertManager.Auth.Web. Keep in sync with the port assigned in
# the component registry in .devcontainer/local-stack-components.sh.
PORT=3004
