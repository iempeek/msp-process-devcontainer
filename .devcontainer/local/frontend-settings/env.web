# .devcontainer/frontend/env.web
# Local-stack overrides for AlertManager.Web (mspprocess-ui/Web/AlertManager.Web),
# sourced by .devcontainer/local-stack-frontend.sh before it
# launches this app's vite dev server.
# Derived from that repo's Web/AlertManager.Web/config/.env.Development -
# only the backend-pointing URLs are swapped to local-stack equivalents;
# everything else (external asset URLs, dev tokens already public in that
# file) is copied through unchanged.
REACT_APP_BASE_API_URL='http://localhost:5000'
REACT_APP_SIGNAL_R_URL='http://localhost:5229/hub'
REACT_APP_BASE_MAILBOX_DOMAIN='in.alertmanager.co'
REACT_APP_PROJECT_NAME='MSP Process [local]'
REACT_APP_AUTH_URL='http://localhost:3001'
REACT_APP_POD_URL='http://localhost:3002'
REACT_APP_CLIENT_PORTAL_BASE_DOMAIN='.dev-cp.mspprocess.com'
# Chat bubble. The real KB chat widget (loader script, /kb.html, /api/public-kb)
# is a separate hosted product that does not exist in this repo, so pointing at
# it makes the local app depend on manage-dev being reachable - and renders the
# browser's network-error page inside the bubble when it isn't. By default we
# serve a local stand-in from the wiremock sidecar that iframes the live chat
# widget we actually run (:3004 -> LiveChat.Api :5033); see
# .devcontainer/local/infrastructure-settings/wiremock/__files/kb-chat-widget.js.
#
# Set KB_WIDGET_URL in .devcontainer/.env to go back to the real remote widget.
#
# The token means different things in the two modes, hence the branch (this
# file is sourced by local-stack-frontend.sh, so shell syntax is fine here):
#   local stand-in -> the LIVE CHAT widget code (LOCAL_CHAT_WIDGET_CODE);
#                     empty is fine, the stand-in then renders nothing rather
#                     than a broken frame.
#   real remote    -> the KB token; defaulted to the dev value that is already
#                     public in the frontend repo's config/.env.Development.
if [ -n "${KB_WIDGET_URL:-}" ]; then
  REACT_APP_KB_WIDGET_URL="$KB_WIDGET_URL"
  REACT_APP_KB_WIDGET_TOKEN="${KB_WIDGET_TOKEN:-25a3b3a008075937053aad5c31ed6edb}"
else
  REACT_APP_KB_WIDGET_URL='http://localhost:8080/kb-chat-widget.js'
  REACT_APP_KB_WIDGET_TOKEN="${LOCAL_CHAT_WIDGET_CODE:-}"
fi
