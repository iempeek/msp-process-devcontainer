{
  "request": {
    "method": "PUT",
    "urlPathPattern": "/secrets/[^/]+"
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "value": "wiremock-accepted (the stub is stateless - the stored value is NOT echoed back: secret values are often JSON and would break the response template)",
      "id": "https://wiremock:8443/secrets/{{request.pathSegments.[1]}}/local",
      "attributes": {
        "enabled": true,
        "created": 1754000000,
        "updated": 1754000000,
        "recoveryLevel": "Recoverable+Purgeable"
      }
    }
  }
}
