{
  "request": {
    "method": "GET",
    "urlPathPattern": "/2010-04-01/Accounts/[^/]+/IncomingPhoneNumbers\\.json"
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "first_page_uri": "{{{request.path}}}?Page=0&PageSize=50",
      "end": 0,
      "start": 0,
      "previous_page_uri": null,
      "next_page_uri": null,
      "page": 0,
      "page_size": 50,
      "uri": "{{{request.url}}}",
      "incoming_phone_numbers": [
        {
          "sid": "PNwiremock000000000000000000000001",
          "account_sid": "ACwiremock000000000000000000000001",
          "phone_number": "{{#if request.query.PhoneNumber}}{{request.query.PhoneNumber}}{{else}}+15005550006{{/if}}",
          "friendly_name": "WireMock incoming number",
          "status": "in-use",
          "capabilities": { "voice": true, "sms": true, "mms": true, "fax": false },
          "sms_url": "",
          "voice_url": "",
          "date_created": "Wed, 05 Aug 2026 12:00:00 +0000",
          "date_updated": "Wed, 05 Aug 2026 12:00:00 +0000"
        }
      ]
    }
  }
}
