{
  "request": {
    "method": "POST",
    "urlPathPattern": "/chargebee/api/v2/items"
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "item": {
        "id": "{{formData request.body 'form' urlDecode=true}}{{#if form.id}}{{form.id}}{{else}}wiremock-item{{/if}}",
        "name": "WireMock item",
        "status": "active",
        "item_family_id": "MSPProcess",
        "object": "item"
      }
    }
  }
}
