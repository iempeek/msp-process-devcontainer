{
  "request": {
    "method": "ANY",
    "urlPathPattern": "/chargebee/api/v2/customers/[^/]+(/update_billing_info|/credit_card)?"
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "customer": {
        "id": "{{request.pathSegments.[4]}}",
        "first_name": "Local",
        "last_name": "Developer",
        "email": "local-dev-billing@wiremock.local",
        "phone": "+15005550006",
        "auto_collection": "on",
        "deleted": false,
        "object": "customer",
        "billing_address": {
          "first_name": "Local",
          "last_name": "Developer",
          "line1": "1 Dev Street",
          "line2": "",
          "city": "Springfield",
          "state": "IL",
          "country": "US",
          "zip": "62701",
          "object": "billing_address"
        }
      },
      "card": {
        "status": "valid",
        "first_name": "Local",
        "last_name": "Developer",
        "last4": "4242",
        "card_type": "visa",
        "expiry_month": 12,
        "expiry_year": 2030,
        "masked_number": "************4242",
        "customer_id": "{{request.pathSegments.[4]}}",
        "object": "card"
      }
    }
  }
}
